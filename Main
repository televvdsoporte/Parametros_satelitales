<script>

    // DATOS DE EJEMPLO: posteriormente los reemplazaremos
    // por los parámetros satelitales reales.

    const parametros = [
        {
            satelite: "SES-6",
            posicion: "40.5° O",
            canal: "Canal de prueba 1",
            frecuencia: "3710",
            polarizacion: "H",
            symbolRate: "30000",
            fec: "3/4",
            estandar: "DVB-S2"
        },
        {
            satelite: "INTELSAT 21",
            posicion: "58.0° O",
            canal: "Canal de prueba 2",
            frecuencia: "3840",
            polarizacion: "V",
            symbolRate: "27500",
            fec: "5/6",
            estandar: "DVB-S2"
        },
        {
            satelite: "AMAZONAS 3",
            posicion: "61.0° O",
            canal: "Canal de prueba 3",
            frecuencia: "4120",
            polarizacion: "H",
            symbolRate: "30000",
            fec: "3/4",
            estandar: "DVB-S"
        }
    ];

    function mostrarDatos(datos) {

        const tabla = document.getElementById("tablaDatos");

        tabla.innerHTML = "";

        if (datos.length === 0) {
            tabla.innerHTML =
                '<tr><td colspan="8" class="empty">No se encontraron resultados.</td></tr>';
            return;
        }

        datos.forEach(item => {

            tabla.innerHTML += `
                <tr>
                    <td><strong>${item.satelite}</strong></td>
                    <td>${item.posicion}</td>
                    <td>${item.canal}</td>
                    <td>${item.frecuencia}</td>
                    <td><span class="badge">${item.polarizacion}</span></td>
                    <td>${item.symbolRate}</td>
                    <td>${item.fec}</td>
                    <td>${item.estandar}</td>
                </tr>
            `;

        });

    }

    function filtrar() {

        const busqueda = document.getElementById("busqueda").value.toLowerCase();
        const satelite = document.getElementById("filtroSatelite").value;
        const polarizacion = document.getElementById("filtroPolarizacion").value;

        const resultados = parametros.filter(item => {

            const coincideBusqueda =
                Object.values(item).some(valor =>
                    String(valor).toLowerCase().includes(busqueda)
                );

            const coincideSatelite =
                satelite === "" || item.satelite === satelite;

            const coincidePolarizacion =
                polarizacion === "" || item.polarizacion === polarizacion;

            return coincideBusqueda && coincideSatelite && coincidePolarizacion;

        });

        mostrarDatos(resultados);

    }

    function cargarSatélites() {

        const selector = document.getElementById("filtroSatelite");

        const satelites = [...new Set(parametros.map(item => item.satelite))];

        satelites.forEach(satelite => {

            const opcion = document.createElement("option");

            opcion.value = satelite;
            opcion.textContent = satelite;

            selector.appendChild(opcion);

        });

    }

    cargarSatélites();
    mostrarDatos(parametros);

</script>

</body>
