<body>

<header>
    <h1>Portal de Parámetros Satelitales</h1>
    <p>Consulta de frecuencias y servicios de transmisión satelital</p>
</header>

<main>
    <section class="panel">

        <h2>Consulta de parámetros</h2>

        <div class="filters">

            <input
                type="text"
                id="busqueda"
                placeholder="Buscar satélite, canal o frecuencia..."
                oninput="filtrar()"
            >

            <select id="filtroSatelite" onchange="filtrar()">
                <option value="">Todos los satélites</option>
            </select>

            <select id="filtroPolarizacion" onchange="filtrar()">
                <option value="">Todas las polarizaciones</option>
                <option value="H">Horizontal (H)</option>
                <option value="V">Vertical (V)</option>
                <option value="L">Circular izquierda (L)</option>
                <option value="R">Circular derecha (R)</option>
            </select>

        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Satélite</th>
                        <th>Posición orbital</th>
                        <th>Canal</th>
                        <th>Frecuencia (MHz)</th>
                        <th>Polarización</th>
                        <th>Symbol Rate</th>
                        <th>FEC</th>
                        <th>Estándar</th>
                    </tr>
                </thead>

                <tbody id="tablaDatos"></tbody>
            </table>
        </div>

    </section>
